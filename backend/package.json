{
  "name": "ssaems-backend",
  "version": "0.1.0",
  "description": "SSAEMS backend - Node.js + Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "pm2:start": "pm2 start ecosystem.config.json --env production",
    "pm2:stop": "pm2 stop ssaems-backend",
    "pm2:restart": "pm2 restart ssaems-backend",
    "pm2:logs": "pm2 logs ssaems-backend",
    "seed": "node scripts/seed.js",
    "test": "node tests/run_tests.js",
    "test:integration": "node tests/run_integration.js",
    "test:verify": "node tests/verify_flow.js",
    "import:students": "node scripts/importStudentsFromCSV.js",
    "verify:students": "node scripts/verifyStudentImport.js",
    "admin:control": "node scripts/adminDatabaseControl.js",
    "create:indexes": "node scripts/createDatabaseIndexes.js"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "archiver": "^5.3.1",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^6.15.0",
    "form-data": "^4.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.3.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "pdfkit": "^0.13.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
